# Which AI backend to use: anthropic (default), openai, or gemini.
# Leave unset to use Anthropic. Only fill in the key/model pair for
# whichever one you pick — the others can stay commented out.
# AI_PROVIDER="anthropic"

ANTHROPIC_API_KEY="your-anthropic-api-key"
# ANTHROPIC_MODEL="claude-sonnet-5"

# OPENAI_API_KEY="your-openai-api-key"
# OPENAI_MODEL="gpt-4o"                 # required if AI_PROVIDER=openai — pick a real model id from your account, don't guess

# GEMINI_API_KEY="your-google-ai-api-key"
# GEMINI_MODEL="gemini-3.6-flash"       # required if AI_PROVIDER=gemini — confirmed live against a real account (Aug 2026); verify against your own if this changes

# Optional
# CLASSIFICATION_SIGNING_SECRET="a separate secret for HMAC-signing the
#   classification step; falls back to whichever provider key is set"
# PORT=3000
